<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventnest_background"
    android:orientation="vertical">

    <!-- Header with the existing back-arrow drawable. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/button_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_event_details"
            android:textColor="@color/eventnest_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Event information scrolls while the action buttons stay below. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/eventnest_text"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Intro to Android Workshop" />

            <!-- Reuse the rounded white background from the event form. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_form_field"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_event_date"
                    android:textColor="@color/eventnest_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/eventnest_primary"
                    android:gravity="center_vertical"
                    android:textColor="@color/eventnest_text"
                    android:textSize="16sp"
                    tools:text="Oct 15, 2026" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_event_time"
                    android:textColor="@color/eventnest_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textEventTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableStart="@drawable/ic_time"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/eventnest_text"
                    android:textSize="16sp"
                    tools:text="9:00 AM" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_event_location"
                    android:textColor="@color/eventnest_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/eventnest_text"
                    android:textSize="16sp"
                    tools:text="Hall B, Engineering Building" />

                <TextView
                    android:id="@+id/textRegisteredLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_registered"
                    android:textColor="@color/eventnest_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textRegisteredCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableStart="@drawable/ic_people"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/eventnest_text"
                    android:textSize="16sp"
                    tools:text="24 of 40" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_about_event"
                android:textColor="@color/eventnest_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/eventnest_text"
                android:textSize="16sp"
                tools:text="A hands-on introduction to building your first Android app." />

        </LinearLayout>

    </ScrollView>

    <!-- Organizer actions: Java will connect these buttons next. -->
    <LinearLayout
        android:id="@+id/layoutOrganizerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/white"
            android:text="@string/button_delete"
            android:textAllCaps="false"
            android:textColor="#B3261E" />

        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/eventnest_primary"
            android:text="@string/button_edit"
            android:textAllCaps="false"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- Student action: shown only for students -->
    <LinearLayout
        android:id="@+id/layoutStudentActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/button_register"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/bg_register_button"
            app:cornerRadius="28dp" />
    </LinearLayout>

</LinearLayout>