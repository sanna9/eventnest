<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventnest_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Back navigation and screen title. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/button_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_registered_students"
            android:textColor="@color/eventnest_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Choose the event whose students should be displayed. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:labelFor="@+id/spinnerEvents"
        android:text="@string/label_select_event"
        android:textColor="@color/eventnest_text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerEvents"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_form_field"
        android:spinnerMode="dropdown" />

    <!-- Status message for empty event or student lists. -->
    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/message_no_registered_students"
        android:textColor="@color/eventnest_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />

    <!-- Java supplies the number of active registrations. -->
    <TextView
        android:id="@+id/textTotalRegistered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textColor="@color/eventnest_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>