<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventnest_background"
    android:orientation="vertical">

    <!-- Header: back arrow and screen title. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/textFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Event"
            android:textColor="@color/eventnest_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Takes the available space and scrolls when needed. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title field. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_form_field"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/inputTitle"
                    android:text="Title"
                    android:textColor="@color/eventnest_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/inputTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:inputType="textCapSentences"
                    android:singleLine="true"
                    android:textColor="@color/eventnest_text"
                    android:textSize="16sp"
                    tools:text="Intro to Android Workshop" />

            </LinearLayout>

            <!-- Description field. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_form_field"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/inputDescription"
                    android:text="Description"
                    android:textColor="@color/eventnest_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/inputDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="4"
                    android:textColor="@color/eventnest_text"
                    android:textSize="16sp"
                    tools:text="A hands-on introduction to building your first Android app." />

            </LinearLayout>

            <!-- Location icon beside its label and input. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_form_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/inputLocation"
                        android:text="Location"
                        android:textColor="@color/eventnest_text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/inputLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="textCapWords"
                        android:textColor="@color/eventnest_text"
                        android:textSize="16sp"
                        tools:text="Hall B, Engineering Building" />

                </LinearLayout>

            </LinearLayout>

            <!-- Date and time columns have equal width. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textColor="@color/eventnest_text_secondary"
                        android:textSize="12sp" />

                    <!-- Tapping opens the date picker. -->
                    <TextView
                        android:id="@+id/buttonSelectDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="56dp"
                        android:background="@drawable/bg_form_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawableTint="@color/eventnest_primary"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:text="Select date"
                        android:textColor="@color/eventnest_text"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textColor="@color/eventnest_text_secondary"
                        android:textSize="12sp" />

                    <!-- Tapping opens the time picker. -->
                    <TextView
                        android:id="@+id/buttonSelectTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="56dp"
                        android:background="@drawable/bg_form_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:drawableStart="@drawable/ic_time"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:text="Select time"
                        android:textColor="@color/eventnest_text"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Capacity input: database support still needs adding. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_form_field"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/inputCapacity"
                    android:text="Capacity"
                    android:textColor="@color/eventnest_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/inputCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:inputType="number"
                    android:textColor="@color/eventnest_text"
                    android:textSize="16sp"
                    tools:text="40" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Save stays below the scrollable form. -->
    <Button
        android:id="@+id/buttonSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/eventnest_primary"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@color/white" />

</LinearLayout>