<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_form_field"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Event month and day. -->
    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_icon"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/textEventMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eventnest_primary"
            android:textSize="12sp"
            tools:text="OCT" />

        <TextView
            android:id="@+id/textEventDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eventnest_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="05" />

    </LinearLayout>

    <!-- Event title and location. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/eventnest_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Welcome Week Mixer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location"
                app:tint="@color/eventnest_text_secondary" />

            <TextView
                android:id="@+id/textEventLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:textColor="@color/eventnest_text_secondary"
                android:textSize="12sp"
                tools:text="Student Center" />

        </LinearLayout>

    </LinearLayout>

    <!-- Number of active registrations for this event. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textRegisteredCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eventnest_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="23" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_registered"
            android:textColor="@color/eventnest_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>