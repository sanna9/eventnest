<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_form_field"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Decorative student icon. -->
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_dashboard_icon"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_people" />

    <!-- Student information supplied by the adapter. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/eventnest_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Jane Doe" />

        <TextView
            android:id="@+id/textStudentEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/eventnest_text_secondary"
            android:textSize="14sp"
            tools:text="jane@student.edu" />

    </LinearLayout>

</LinearLayout>