<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventnest_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back arrow and screen heading. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/button_back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/title_send_notification"
                android:textColor="@color/eventnest_text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Organizer chooses which event receives the message. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/spinnerEvents"
            android:text="@string/label_select_event"
            android:textColor="@color/eventnest_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_form_field"
            android:orientation="vertical"
            android:padding="4dp">

            <Spinner
                android:id="@+id/spinnerEvents"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/label_select_event"
                android:enabled="false"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <!-- Java displays the selected event's active recipient count. -->
        <TextView
            android:id="@+id/textRecipients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notification_recipients_loading"
            android:textColor="@color/eventnest_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/notification_recipients_info"
            android:textColor="@color/eventnest_text_secondary"
            android:textSize="14sp" />

        <!-- Message input reuses the existing bordered background. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/inputMessage"
            android:text="@string/label_notification_message"
            android:textColor="@color/eventnest_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_form_field"
            android:gravity="top|start"
            android:hint="@string/hint_notification_message"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="6"
            android:padding="16dp"
            android:textColor="@color/eventnest_text"
            android:textColorHint="@color/eventnest_text_secondary"
            android:textSize="16sp" />

        <!-- Displays event-loading or sending errors when needed. -->
        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <!-- Enabled after an event and its recipients are loaded. -->
        <Button
            android:id="@+id/buttonSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/eventnest_primary"
            android:enabled="false"
            android:minHeight="56dp"
            android:text="@string/button_send_notification"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>